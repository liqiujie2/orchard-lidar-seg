# Normalise text files, keep the point-cloud payload binary.
* text=auto

# Keep sources LF everywhere for reproducibility across Linux/Windows
*.py    text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf
*.cff   text eol=lf
*.sh    text eol=lf

# LiDAR data (KITTI / SemanticKITTI format) -- binary, no diffs, no EOL munging
*.bin   binary
*.label binary

# Model weights
*.pth   binary
*.pt    binary
*.ckpt  binary
*.onnx  binary
